# Copier en `.env` À CÔTÉ du docker-compose.yml, puis remplir.
# `chmod 600 .env` — ce fichier contient tous les secrets de production.
# NE JAMAIS le committer (v4/infra/aws/.env est dans .gitignore).

# --- Environnement ---------------------------------------------------------
# `production` active HSTS et FAIT ÉCHOUER LE DÉMARRAGE si CORS=* ou si le
# jeton admin est faible (validate_security_at_startup). C'est voulu.
APP_ENV=production
LOG_LEVEL=INFO

# --- Base de données (utilisé par docker-compose pour construire DATABASE_URL) ---
POSTGRES_USER=sahten
POSTGRES_DB=sahten
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Fournisseurs LLM ------------------------------------------------------
# Clé fournie par Rudy le 3 août 2026 (facturation WhiteBeard, pas Sami).
OPENAI_API_KEY=
COHERE_API_KEY=

# Le reranker local de secours (BAAI/bge-reranker-v2-m3) exige torch, qui n'est
# PAS installé dans l'image. À laisser sur false : sinon on tente un import qui
# échouera au premier repli, en pleine requête utilisateur.
ENABLE_LOCAL_RERANK_FALLBACK=false

# --- CMS L'Orient-Le Jour --------------------------------------------------
OLJ_API_BASE=https://api.lorientlejour.com/cms
OLJ_API_KEY=
# Secret HMAC partagé avec l'automatisation du CMS (signature X-Webhook-Signature).
WEBHOOK_SECRET=

# --- Sécurité --------------------------------------------------------------
# openssl rand -base64 32 — protège /dashboard, /admin, /api/analytics, /api/traces.
SAHTEN_ADMIN_API_TOKEN=
# Pas de `*` en production : le démarrage échoue.
SAHTEN_CORS_ORIGINS=https://www.lorientlejour.com,https://lorientlejour.com
# Nombre de proxys de confiance DEVANT l'app. Ici : Cloudflare seul -> 1.
# Mettre 0 ou 2 casse le rate-limit (tous les visiteurs partageraient un quota,
# ou l'en-tête deviendrait falsifiable). Voir docs/aws-deploy-security.md §3.
SAHTEN_TRUSTED_PROXY_HOPS=1
# /docs masqué en production.
SAHTEN_EXPOSE_OPENAPI=false
